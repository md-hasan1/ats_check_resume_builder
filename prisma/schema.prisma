generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Better Auth Models
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions             Session[]
  accounts             Account[]
  resumes              Resume[]
  reports              Report[]
  subscription         Subscription?
  usageLogs            UsageLog[]
  jobDescriptions      JobDescription[]
  tailoredResumes      TailoredResume[]
  coverLetters         CoverLetter[]
  recruiterSimulations RecruiterSimulation[]
  linkedInAnalyses     LinkedInAnalysis[]
  interviewPreps       InterviewPrep[]
  blogComments         BlogComment[]

  // ATS SaaS Multi-Tenant Relations
  organizationMembers    OrganizationMember[]
  invitationsSent        Invitation[]              @relation("InvitedBy")
  jobsCreated            Job[]                     @relation("JobCreator")
  stageTransitions       ApplicationStageHistory[] @relation("StageMover")
  interviewerAssignments Interviewer[]
  interviewFeedbacks     InterviewFeedback[]       @relation("InterviewerUser")
  candidateNotes         CandidateNote[]           @relation("NoteAuthor")
  activityLogs           ActivityLog[]             @relation("ActivityUser")
  notifications          Notification[]            @relation("NotificationUser")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============================================================
// Application Models
// ============================================================

model Resume {
  id           String   @id @default(cuid())
  userId       String
  fileName     String
  fileUrl      String
  fileType     String   // pdf, docx, doc
  fileSize     Int      // bytes
  rawText      String?  @db.Text
  parsedData   Json?    // Structured resume fields
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports              Report[]
  tailoredResumes      TailoredResume[]
  coverLetters         CoverLetter[]
  recruiterSimulations RecruiterSimulation[]

  @@index([userId])
  @@map("resumes")
}

model Report {
  id              String       @id @default(cuid())
  userId          String
  resumeId        String
  name            String       @default("Untitled Report")
  jobTitle        String?
  jobDescription  String       @db.Text
  jobUrl          String?
  overallScore    Float        @default(0)
  analysisResult  Json?        // Full ATS analysis JSON
  status          ReportStatus @default(PENDING)
  processingTime  Int?         // ms
  aiTokensUsed    Int?
  shareToken      String?      @unique
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([shareToken])
  @@map("reports")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // "resume_check", "pdf_export", etc.
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
  @@map("usage_logs")
}

model BlogPost {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  excerpt      String?
  content      String       @db.Text
  coverImage   String?
  categorySlug String?
  readingTime  String       @default("5 min read")
  published    Boolean      @default(true)
  authorName   String?
  tags         String[]     @default([])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category BlogCategory? @relation(fields: [categorySlug], references: [slug], onDelete: SetNull)
  comments BlogComment[]

  @@map("blog_posts")
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String?
  email     String
  subject   String
  message   String       @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("support_tickets")
}

// ============================================================
// Copilot & AI Models
// ============================================================

model JobDescription {
  id           String   @id @default(cuid())
  userId       String
  title        String
  company      String?
  sourceUrl    String?
  content      String   @db.Text
  parsedSkills Json?
  keywords     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumes  TailoredResume[]
  coverLetters     CoverLetter[]

  @@map("job_descriptions")
}

model TailoredResume {
  id              String   @id @default(cuid())
  userId          String
  resumeId        String
  jobId           String?
  versionName     String
  targetRole      String
  targetCompany   String?
  content         Json
  diffHighlights  Json?
  atsScore        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("tailored_resumes")
}

model CoverLetter {
  id             String   @id @default(cuid())
  userId         String
  resumeId       String
  jobId          String?
  targetCompany  String
  targetRole     String
  tone           String   @default("professional")
  length         String   @default("standard")
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume          @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("cover_letters")
}

model RecruiterSimulation {
  id               String   @id @default(cuid())
  userId           String
  resumeId         String
  jobId            String?
  impressionScore  Int
  hiringConfidence Int
  interviewChance  Int
  strengths        Json
  weaknesses       Json
  missingInfo      Json
  overallImpression String  @db.Text
  createdAt        DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("recruiter_simulations")
}

model AdminMetric {
  id        String   @id @default(cuid())
  metric    String
  value     Float
  metadata  Json?
  timestamp DateTime @default(now())

  @@map("admin_metrics")
}

model LinkedInAnalysis {
  id                String   @id @default(cuid())
  userId            String
  profileUrl        String?
  profileContent    String   @db.Text
  recruiterScore    Int
  currentHeadline   String?
  suggestedHeadline String
  currentAbout      String?  @db.Text
  suggestedAbout    String   @db.Text
  missingKeywords   Json
  networkingTips    Json
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("linkedin_analyses")
}

model InterviewPrep {
  id          String   @id @default(cuid())
  userId      String
  targetRole  String
  company     String?
  questions   Json     // technical, behavioral, hr, systemDesign
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("interview_preps")
}

model SalaryInsight {
  id            String   @id @default(cuid())
  role          String
  location      String
  experience    String
  averageSalary Int
  medianSalary  Int
  top10Percent  Int
  marketDemand  String
  createdAt     DateTime @default(now())

  @@map("salary_insights")
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  posts     BlogPost[]
  createdAt DateTime   @default(now())

  @@map("blog_categories")
}


model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("blog_comments")
}

model ResumeTemplate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String   // Software Engineer, Frontend, Product Manager, etc.
  description String
  previewImage String?
  isPro       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("resume_templates")
}

model ResumeExample {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String
  role        String
  content     Json
  whyItWorks  String   @db.Text
  atsTips     Json
  createdAt   DateTime @default(now())

  @@map("resume_examples")
}

// ============================================================
// Enums
// ============================================================

enum Role {
  USER
  ADMIN
}

enum ReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================================
// Multi-Tenant ATS SaaS Models
// ============================================================

model Organization {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  logo             String?
  website          String?
  billingEmail     String?
  plan             SubscriptionPlan @default(FREE)
  stripeCustomerId String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  members        OrganizationMember[]
  invitations    Invitation[]
  jobs           Job[]
  candidates     Candidate[]
  applications   Application[]
  pipelineStages PipelineStage[]
  candidateNotes CandidateNote[]
  candidateTags  CandidateTag[]
  notifications  Notification[]
  activityLogs   ActivityLog[]

  @@map("organizations")
}

model OrganizationMember {
  id             String        @id @default(cuid())
  organizationId String
  userId         String
  role           OrgMemberRole @default(RECRUITER)
  status         MemberStatus  @default(ACTIVE)
  joinedAt       DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrgMemberRole    @default(RECRUITER)
  token          String           @unique
  inviterId      String
  expiresAt      DateTime
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitedBy", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

model Job {
  id                  String         @id @default(cuid())
  organizationId      String
  title               String
  department          String?
  location            String?
  employmentType      EmploymentType @default(FULL_TIME)
  workplaceType       WorkplaceType  @default(HYBRID)
  experienceLevel     String?
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String         @default("USD")
  description         String         @db.Text
  requirements        String?        @db.Text
  requiredSkills      String[]       @default([])
  preferredSkills     String[]       @default([])
  applicationDeadline DateTime?
  status              JobStatus      @default(DRAFT)
  createdById         String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  applications   Application[]
  pipelineStages PipelineStage[]

  @@index([organizationId, status])
  @@index([organizationId, department])
  @@map("jobs")
}

model Candidate {
  id             String          @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  email          String
  phone          String?
  location       String?
  headline       String?
  summary        String?         @db.Text
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  resumeFileUrl  String?
  resumeFileName String?
  rawResumeText  String?         @db.Text
  parsedData     Json?
  source         CandidateSource @default(DIRECT_UPLOAD)
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applications Application[]
  notes        CandidateNote[]
  tags         CandidateTag[]

  @@unique([organizationId, email])
  @@index([organizationId, email])
  @@index([organizationId, lastName])
  @@map("candidates")
}

model Application {
  id              String           @id @default(cuid())
  organizationId  String
  jobId           String
  candidateId     String
  stage           ApplicationStage @default(APPLIED)
  matchScore      Float?
  matchBreakdown  Json?
  aiSummary       String?          @db.Text
  rejectionReason String?
  coverLetter     String?          @db.Text
  customAnswers   Json?
  trackingToken   String?
  appliedAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate      Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stageHistories ApplicationStageHistory[]
  interviews     Interview[]

  @@unique([jobId, candidateId])
  @@index([organizationId, jobId, stage])
  @@index([candidateId])
  @@index([trackingToken])
  @@map("applications")
}

model ApplicationStageHistory {
  id            String           @id @default(cuid())
  applicationId String
  fromStage     ApplicationStage
  toStage       ApplicationStage
  movedById     String
  notes         String?
  createdAt     DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  movedBy     User        @relation("StageMover", fields: [movedById], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_stage_histories")
}

model PipelineStage {
  id             String           @id @default(cuid())
  organizationId String
  jobId          String?
  name           String
  stageKey       ApplicationStage
  orderIndex     Int
  color          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, jobId, orderIndex])
  @@map("pipeline_stages")
}

model Interview {
  id              String          @id @default(cuid())
  organizationId  String
  applicationId   String
  title           String
  interviewType   InterviewType   @default(TECHNICAL)
  scheduledAt     DateTime
  durationMinutes Int             @default(45)
  meetingUrl      String?
  location        String?
  status          InterviewStatus @default(SCHEDULED)
  instructions    String?         @db.Text
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  application  Application         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewers Interviewer[]
  feedbacks    InterviewFeedback[]

  @@index([organizationId, scheduledAt])
  @@index([applicationId])
  @@map("interviews")
}

model Interviewer {
  id          String @id @default(cuid())
  interviewId String
  userId      String

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interviewId, userId])
  @@map("interviewers")
}

model InterviewFeedback {
  id                    String              @id @default(cuid())
  interviewId           String
  interviewerId         String
  overallRecommendation RecommendationScore
  rating                Int
  technicalScore        Int?
  communicationScore    Int?
  cultureFitScore       Int?
  strengths             String?             @db.Text
  weaknesses            String?             @db.Text
  notes                 String?             @db.Text
  submittedAt           DateTime            @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation("InterviewerUser", fields: [interviewerId], references: [id], onDelete: Cascade)

  @@unique([interviewId, interviewerId])
  @@map("interview_feedbacks")
}

model CandidateNote {
  id             String   @id @default(cuid())
  organizationId String
  candidateId    String
  authorId       String
  content        String   @db.Text
  isInternal     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author       User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId, candidateId])
  @@map("candidate_notes")
}

model CandidateTag {
  id             String  @id @default(cuid())
  organizationId String
  candidateId    String
  name           String
  color          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate    Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, name])
  @@index([organizationId])
  @@map("candidate_tags")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("ActivityUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  title          String
  message        String
  link           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ============================================================
// Multi-Tenant Enums
// ============================================================

enum OrgMemberRole {
  ORG_OWNER
  ADMIN
  RECRUITER
  HIRING_MANAGER
  INTERVIEWER
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum CandidateSource {
  DIRECT_UPLOAD
  CAREER_PAGE
  RECRUITER_SOURCED
  AGENCY_REFERRAL
}

enum ApplicationStage {
  APPLIED
  SCREENING
  SHORTLISTED
  ASSESSMENT
  INTERVIEW
  FINAL_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewType {
  SCREENING
  TECHNICAL
  BEHAVIORAL
  SYSTEM_DESIGN
  CULTURE_FIT
  FINAL
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum RecommendationScore {
  STRONG_YES
  YES
  NEUTRAL
  NO
  STRONG_NO
}
