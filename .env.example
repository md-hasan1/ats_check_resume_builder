# ===========================================
# ATS Resume Checker - Environment Variables
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/ats_db?schema=public"

# Better Auth
BETTER_AUTH_SECRET="your-secret-key-min-32-chars-long-here"
BETTER_AUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# AI Providers
OPENAI_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
AI_PROVIDER="openai" # "openai" | "gemini"

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""

# Resend (Email)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# File Storage (supabase | s3 | cloudinary)
STORAGE_PROVIDER="supabase"

# Supabase Storage
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AWS S3 (alternative)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""

# Cloudinary (alternative)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
